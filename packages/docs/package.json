		"@astrojs/starlight": "^0.41.5",
		"@monaco-editor/react": "^4.7.0",
		"@nanostores/react": "^1.1.0",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"astro": "^7.1.6",
		"i18next": "^26.3.6",
		"lucide-react": "^1.28.0",
		"monaco-editor": "^0.56.0",
		"nanostores": "^1.4.2",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-i18next": "^17.0.11",
		"react-toastify": "^11.1.0",
